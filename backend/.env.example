# Backend Environment Variables
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
SECRET_KEY=your_development_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# NLP Configuration
SPACY_MODEL=en_core_web_trf
HUGGINGFACE_MODEL_NAME=bert-base-uncased
NEWS_API_KEY=your_news_api_key_here
NEWS_FETCH_INTERVAL_MINUTES=60

# GNN / PyTorch Configuration
DEVICE=cuda
MODEL_SAVE_PATH=backend/app/ml/models/checkpoints/
GNN_EMBEDDING_DIM=128
GNN_HIDDEN_CHANNELS=64
GNN_NUM_LAYERS=3
LEARNING_RATE=0.001
BATCH_SIZE=32
EPOCHS=100

# WebSocket
WS_HEARTBEAT_INTERVAL=30

