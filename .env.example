# ==============================================================================
# AtmoGraph - Supply Chain Ripple Effect Predictor
# Root Environment Variables Template (.env.example)
# ==============================================================================

# --- Server & FastAPI Configuration ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
SECRET_KEY=your_development_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Neo4j Graph Database Configuration ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# --- NLP Engine & Ingestion Configuration ---
SPACY_MODEL=en_core_web_trf
HUGGINGFACE_MODEL_NAME=bert-base-uncased
NEWS_API_KEY=your_news_api_key_here
NEWS_FETCH_INTERVAL_MINUTES=60

# --- Machine Learning & GNN Configuration ---
DEVICE=cuda
MODEL_SAVE_PATH=backend/app/ml/models/checkpoints/
GNN_EMBEDDING_DIM=128
GNN_HIDDEN_CHANNELS=64
GNN_NUM_LAYERS=3
LEARNING_RATE=0.001
BATCH_SIZE=32
EPOCHS=100

# --- WebSocket Configuration ---
WS_HEARTBEAT_INTERVAL=30

# --- Frontend Environment Variables (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws

